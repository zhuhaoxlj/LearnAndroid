<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".LeakDemoActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="内存泄漏演示"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="点击下方按钮触发不同类型的内存泄漏"
        android:textColor="#FF0000"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_leak_static"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="示例1：静态变量持有Activity引用" />

    <Button
        android:id="@+id/btn_leak_thread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="示例2：匿名内部类持有外部类引用" />

    <Button
        android:id="@+id/btn_leak_handler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="示例3：Handler泄漏" />

    <Button
        android:id="@+id/btn_leak_singleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="示例4：单例模式导致的内存泄漏" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="测试流程：\n1. 点击以上任一按钮触发内存泄漏\n2. 点击下方'关闭'按钮关闭当前Activity\n3. 等待LeakCanary检测并通知内存泄漏"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="关闭当前Activity"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E91E63" />

</LinearLayout> 